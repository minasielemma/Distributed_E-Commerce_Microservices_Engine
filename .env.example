# Root Environment Configuration Example

# Django Secret Key
SECRET_KEY=django-insecure-e-commerce-microservices-super-secret-key-change-in-production

# Shared Keys Directory
KEYS_DIR=/shared_keys

# Database Credentials
IDENTITY_POSTGRES_DB=identity_db
IDENTITY_POSTGRES_USER=identity_user
IDENTITY_POSTGRES_PASSWORD=identity_pass
IDENTITY_POSTGRES_HOST=identity_db
IDENTITY_POSTGRES_PORT=5432

CATALOG_POSTGRES_DB=catalog_db
CATALOG_POSTGRES_USER=catalog_user
CATALOG_POSTGRES_PASSWORD=catalog_pass
CATALOG_POSTGRES_HOST=catalog_db
CATALOG_POSTGRES_PORT=5432

ORDER_POSTGRES_DB=order_db
ORDER_POSTGRES_USER=order_user
ORDER_POSTGRES_PASSWORD=order_pass
ORDER_POSTGRES_HOST=order_db
ORDER_POSTGRES_PORT=5432

PAYMENT_POSTGRES_DB=payment_db
PAYMENT_POSTGRES_USER=payment_user
PAYMENT_POSTGRES_PASSWORD=payment_pass
PAYMENT_POSTGRES_HOST=payment_db
PAYMENT_POSTGRES_PORT=5432

# Message Broker & Cache
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_URL=redis://redis:6379/0
CATALOG_GRPC_HOST=catalog_service:50051

# Polar Payment Provider Configuration
POLAR_API_KEY=polar_live_or_test_api_key_sample
POLAR_WEBHOOK_SECRET=polar_whsec_sample_secret_key
